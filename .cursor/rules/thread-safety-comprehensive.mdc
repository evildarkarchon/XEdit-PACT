# Thread Safety Comprehensive Rules

## Overview
Thread safety is a **MAIN PRIORITY** for all code in this project. All threading operations must use PySide6 threading modules exclusively and follow established thread safety patterns. This document consolidates all threading requirements, modules, patterns, and standards.

## Core Requirements

### PySide6 Threading Modules Only
- **MUST** use PySide6 threading modules: `QThread`, `QThreadPool`, `QMutex`, `QReadWriteLock`, `QWaitCondition`
- **NEVER** use Python's `threading` module directly for application logic
- **NEVER** use `asyncio` for GUI applications (PySide6 handles event loops)
- **NEVER** use `concurrent.futures` for GUI thread communication

### Required Imports
```python
from PySide6.QtCore import (
    QThread, QThreadPool, QMutex, QReadWriteLock, QWaitCondition,
    QMutexLocker, QReadLocker, QWriteLocker, Signal, QObject
)
```

## Threading Patterns

### QThread Worker Implementation
```python
# ✅ CORRECT: Inherit from QThread for worker threads
class CleaningWorker(QThread):
    # Define signals for communication
    progress = Signal(int, int)  # current, total
    plugin_started = Signal(str)  # plugin name
    plugin_completed = Signal(str, bool, str)  # plugin, success, message
    log_output = Signal(str)  # real-time log output
    error_occurred = Signal(str)  # error message
    finished = Signal()  # completion signal

    def __init__(self, service, state, plugins):
        super().__init__()
        self.service = service
        self.state = state
        self.plugins = plugins
        self._should_stop = False

    def run(self):
        """Worker logic runs in separate thread."""
        try:
            for i, plugin in enumerate(self.plugins):
                if self._should_stop:
                    break
                    
                self.plugin_started.emit(plugin)
                
                # Do work
                result = self.service.clean_plugin(plugin)
                
                self.plugin_completed.emit(plugin, result.success, result.message)
                self.progress.emit(i + 1, len(self.plugins))
                
        except Exception as e:
            self.error_occurred.emit(str(e))
        finally:
            self.finished.emit()

    def stop(self):
        """Gracefully stop the worker."""
        self._should_stop = True
        self.requestInterruption()
        if not self.wait(5000):  # 5 second timeout
            self.terminate()
            self.wait(2000)
```

### Signal/Slot Communication (ONLY METHOD)
```python
# ✅ CORRECT: Connect signals to slots in main thread
class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.worker = CleaningWorker()
        
        # Connect signals to slots - ONLY way to communicate across threads
        self.worker.progress.connect(self.update_progress_bar)
        self.worker.plugin_started.connect(self.on_plugin_started)
        self.worker.plugin_completed.connect(self.on_plugin_completed)
        self.worker.log_output.connect(self.append_log)
        self.worker.error_occurred.connect(self.show_error)
        self.worker.finished.connect(self.on_cleaning_finished)

    def start_cleaning(self):
        self.worker.start()  # Start in separate thread

    def update_progress_bar(self, current, total):
        # This runs in the main thread automatically
        self.progress_bar.setValue(current)
        self.progress_bar.setMaximum(total)

    def on_plugin_started(self, plugin_name):
        # This runs in the main thread automatically
        self.status_label.setText(f"Processing: {plugin_name}")

    def show_error(self, error_message):
        # This runs in the main thread automatically
        QMessageBox.critical(self, "Error", error_message)
```

## Thread-Safe Data Protection

### QMutex for Exclusive Access
```python
# ✅ CORRECT: Protect shared data with QMutex
class ThreadSafeStateManager(QObject):
    state_changed = Signal(str, object)  # property_name, new_value
    
    def __init__(self):
        super().__init__()
        self._data = {}
        self._mutex = QMutex()

    def update_data(self, key, value):
        with QMutexLocker(self._mutex):
            self._data[key] = value
        # Emit signal outside of mutex lock
        self.state_changed.emit(key, value)

    def get_data(self, key):
        with QMutexLocker(self._mutex):
            return self._data.get(key)

    def update_multiple(self, **kwargs):
        with QMutexLocker(self._mutex):
            for key, value in kwargs.items():
                self._data[key] = value
        # Emit signals after releasing lock
        for key, value in kwargs.items():
            self.state_changed.emit(key, value)
```

### QReadWriteLock for Read-Heavy Workloads
```python
# ✅ CORRECT: Use read-write lock for read-heavy scenarios
class ThreadSafeCache:
    def __init__(self):
        self._cache = {}
        self._lock = QReadWriteLock()
    
    def read(self, key):
        with QReadLocker(self._lock):
            return self._cache.get(key)
    
    def write(self, key, value):
        with QWriteLocker(self._lock):
            self._cache[key] = value
    
    def read_multiple(self, keys):
        with QReadLocker(self._lock):
            return {key: self._cache.get(key) for key in keys}
```

### Timeout Protection Against Deadlocks
```python
# ✅ CORRECT: Use timeout to prevent deadlocks
def safe_operation(self):
    if not self._mutex.tryLock(5000):  # 5 second timeout
        raise TimeoutError("Could not acquire lock within timeout")
    try:
        # Perform operation
        self._perform_critical_operation()
    finally:
        self._mutex.unlock()
```

## Anti-Patterns (FORBIDDEN)

### ❌ NEVER: Direct Python threading
```python
import threading  # FORBIDDEN - Don't use Python threading

class BadWorker(threading.Thread):  # FORBIDDEN
    def run(self):
        # This breaks Qt's event loop and thread safety
        pass

# FORBIDDEN: Using threading primitives
lock = threading.Lock()  # Use QMutex instead
event = threading.Event()  # Use QWaitCondition instead
```

### ❌ NEVER: Global variables for communication
```python
# FORBIDDEN: Global variables are not thread-safe
global_data = {}  # Race conditions guaranteed

def worker_function():
    global_data['result'] = compute_result()  # RACE CONDITION

def main_thread_function():
    result = global_data.get('result')  # RACE CONDITION
```

### ❌ NEVER: Direct cross-thread method calls
```python
# FORBIDDEN: Don't call methods directly across threads
class BadPattern:
    def start_worker(self):
        self.worker = WorkerThread()
        self.worker.start()
    
    def update_ui(self):
        # FORBIDDEN: This is called from worker thread
        self.ui_element.setText("Updated")  # Will crash or corrupt
        self.progress_bar.setValue(50)      # Will crash or corrupt
```

### ❌ NEVER: Shared mutable objects
```python
# FORBIDDEN: Don't share mutable objects between threads
class BadPattern:
    def __init__(self):
        self.shared_list = []  # Mutable object - race conditions

    def worker_thread(self):
        self.shared_list.append("item")  # RACE CONDITION

    def main_thread(self):
        item = self.shared_list.pop()  # RACE CONDITION
```

## Data Passing Patterns

### Safe Data Passing Through Signals
```python
# ✅ CORRECT: Pass immutable data or copies through signals
class WorkerThread(QThread):
    result_ready = Signal(dict)

    def __init__(self, data_list):
        super().__init__()
        self.data_list = data_list.copy()  # Copy to avoid sharing

    def run(self):
        result = self.process_data(self.data_list)
        # Always pass copies of mutable data
        self.result_ready.emit(result.copy())
```

### Thread-Safe Initialization
```python
# ✅ CORRECT: Initialize with copies, communicate via signals
class SafeWorker(QThread):
    def __init__(self, config_dict, file_list):
        super().__init__()
        # Make defensive copies of mutable data
        self.config = config_dict.copy()
        self.files = file_list.copy()
        # No shared mutable state after initialization
```

## Performance and Best Practices

### Lock Hierarchy (Prevent Deadlocks)
```python
# ✅ CORRECT: Always acquire locks in consistent order
class MultiLockManager:
    def __init__(self):
        self.lock_a = QMutex()  # Always acquire first  
        self.lock_b = QMutex()  # Always acquire second
    
    def operation_one(self):
        with QMutexLocker(self.lock_a):
            with QMutexLocker(self.lock_b):
                # Critical section
                pass
    
    def operation_two(self):
        with QMutexLocker(self.lock_a):  # Same order
            with QMutexLocker(self.lock_b):  # Same order
                # Critical section
                pass
```

### Minimize Lock Scope
```python
# ✅ CORRECT: Keep locks for minimal time
def efficient_update(self, new_data):
    # Prepare data outside of lock
    processed_data = self.process_data(new_data)
    
    # Minimal lock scope
    with QMutexLocker(self._mutex):
        self._state.update(processed_data)
    
    # Emit signals outside of lock
    self.data_updated.emit(processed_data)
```

