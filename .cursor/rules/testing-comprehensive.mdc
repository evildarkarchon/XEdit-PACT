### Thread Safety Tests
```python
# ✅ CORRECT: Test concurrent access and thread safety
class TestThreadSafety:
    def test_concurrent_state_updates(self):
        """Test concurrent updates to state manager."""
        state = StateManager()
        results = []
        errors = []
        
        def worker_function(worker_id):
            try:
                for i in range(100):
                    key = f"worker_{worker_id}_item_{i}"
                    state.update_data(key, f"value_{i}")
                    retrieved = state.get_data(key)
                    results.append((worker_id, key, retrieved))
            except Exception as e:
                errors.append((worker_id, str(e)))
        
        # Create multiple threads
        threads = []
        for i in range(5):
            thread = threading.Thread(target=worker_function, args=(i,))
            threads.append(thread)
        
        # Start all threads
        for thread in threads:
            thread.start()
        
        # Wait for completion
        for thread in threads:
            thread.join()
        
        # Verify no errors and data integrity
        assert len(errors) == 0
        assert len(results) == 500  # 5 workers * 100 operations
        
        # Verify no data corruption
        for worker_id, key, value in results:
            expected_value = f"value_{key.split('_')[-1]}"
            assert value == expected_value

    def test_yaml_manager_concurrent_file_access(self):
        """Test YAML manager handles concurrent file access safely."""
        with tempfile.NamedTemporaryFile(suffix=".yaml", delete=False) as f:
            test_file = f.name
        
        try:
            manager = YamlManager()
            results = []
            errors = []
            
            def worker_function(worker_id):
                try:
                    for i in range(50):
                        key = f"worker_{worker_id}_key_{i}"
                        value = f"value_{i}"
                        
                        # Write operation
                        manager.set_value(test_file, key, value)
                        
                        # Read operation
                        retrieved = manager.get_value(test_file, key)
                        results.append((worker_id, key, retrieved))
                        
                except Exception as e:
                    errors.append((worker_id, str(e)))
            
            # Run concurrent operations
            threads = []
            for i in range(3):
                thread = threading.Thread(target=worker_function, args=(i,))
                threads.append(thread)
            
            for thread in threads:
                thread.start()
            
            for thread in threads:
                thread.join()
            
            # Verify thread safety
            assert len(errors) == 0
            assert len(results) == 150  # 3 workers * 50 operations
            
        finally:
            os.unlink(test_file)
```

## Assertion Standards

### Meaningful Assertions
```python
# ✅ CORRECT: Specific and meaningful assertions
def test_cleaning_worker_updates_progress():
    """Test that cleaning worker updates progress correctly."""
    mock_service = Mock()
    mock_state = Mock()
    worker = CleaningWorker(mock_service, mock_state, ["plugin1.esp"])
    
    worker.run()
    
    # Specific assertions about behavior
    mock_state.update.assert_called_with(
        is_cleaning=True,
        total_plugins=1,
        plugins_to_clean=["plugin1.esp"],
        progress=0
    )
    mock_state.add_result.assert_called_with("plugin1.esp", "cleaned", mock.ANY)

# ❌ WRONG: Vague or meaningless assertions
def test_cleaning_worker_works():
    """Test that cleaning worker works."""
    worker = CleaningWorker(mock_service, mock_state, ["plugin1.esp"])
    worker.run()
    assert worker is not None  # This doesn't test anything meaningful
```

### Exception Testing
```python
# ✅ CORRECT: Test exceptions properly
def test_cleaning_worker_handles_service_errors():
    """Test that cleaning worker handles service errors gracefully."""
    mock_service = Mock()
    mock_service.validate_environment.return_value = (False, "Service unavailable")
    mock_state = Mock()
    
    worker = CleaningWorker(mock_service, mock_state, ["plugin1.esp"])
    
    # Capture signal emissions
    error_signals = []
    worker.error_occurred.connect(lambda msg: error_signals.append(msg))
    
    worker.run()
    
    # Verify error handling
    assert len(error_signals) == 1
    assert "Service unavailable" in error_signals[0]

def test_yaml_manager_handles_file_errors():
    """Test that YAML manager handles file errors gracefully."""
    manager = YamlManager()
    
    # Test with non-existent file
    result = manager.get_value("/nonexistent/file.yaml", "key")
    assert result is None
    
    # Test with invalid YAML
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", delete=False) as f:
        f.write("invalid: yaml: content: [")
        f.flush()
        
        result = manager.get_value(f.name, "key")
        assert result is None
        
    os.unlink(f.name)
```

## Test Coverage Measurement

### Running Coverage
```bash
# Run tests with coverage reporting
python -m pytest --cov=PactLib --cov=PACT_Interface --cov-report=term-missing --cov-report=html

# Generate detailed coverage report
coverage run -m pytest
coverage report --show-missing
coverage html
```

### Coverage Configuration
```ini
# pyproject.toml or .coveragerc
[tool.coverage.run]
source = ["PactLib", "PACT_Interface"]
omit = [
    "*/tests/*",
    "*/test_*",
    "*/__pycache__/*",
    "*/venv/*",
    "*/.venv/*"
]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "if self.debug:",
    "if settings.DEBUG",
    "raise AssertionError",
    "raise NotImplementedError",
    "if 0:",
    "if __name__ == .__main__.:",
    "class .*\\bProtocol\\):",
    "@(abc\\.)?abstractmethod"
]
fail_under = 90
```

## Test Maintenance Requirements

### Before Making Code Changes
- [ ] Identify existing tests that will be affected
- [ ] Plan new tests for new functionality  
- [ ] Consider edge cases and error conditions
- [ ] Think about integration points and thread safety

### During Code Changes
- [ ] Update existing tests to match new behavior
- [ ] Add new tests for new functionality
- [ ] Ensure all tests pass locally
- [ ] Verify test coverage is maintained or improved

### After Code Changes  
- [ ] Run the full test suite
- [ ] Check test coverage reports
- [ ] Review test names and documentation
- [ ] Ensure tests are still meaningful and useful

## Anti-Patterns to Avoid

### ❌ NEVER: Ignoring failing tests
```python
# Don't ignore, comment out, or skip failing tests
# @pytest.mark.skip(reason="FIXME: This test is broken")
def test_broken_functionality():
    # Fix the test instead of ignoring it
    pass
```

### ❌ NEVER: Tests that don't test behavior
```python
# Don't write tests that don't verify meaningful behavior
def test_function_exists():
    assert function is not None  # Meaningless
    
# DO test actual behavior
def test_function_processes_data_correctly():
    result = function("input_data")
    assert result == "expected_output"
```

### ❌ NEVER: Brittle tests
```python
# Don't test internal implementation details
def test_internal_state():
    assert obj._internal_var == "specific_value"  # Brittle
    
# DO test public behavior
def test_public_behavior():
    result = obj.public_method()
    assert result.status == "success"
```

### ❌ NEVER: Test dependencies
```python
# Don't write tests that depend on other tests
class TestBadDependency:
    def test_first(self):
        global shared_state
        shared_state = "setup"
        
    def test_second(self):
        global shared_state  # Depends on test_first
        assert shared_state == "setup"
```

