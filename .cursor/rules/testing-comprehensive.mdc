### Test Data Factories
```python
# ✅ CORRECT: Use factories for complex test data
class TestDataFactory:
    @staticmethod
    def create_plugin_data(name="test.esp", size=1024, modified_date=None):
        """Create plugin data for testing."""
        if modified_date is None:
            modified_date = datetime.now()
        
        return {
            "name": name,
            "size": size,
            "modified": modified_date,
            "path": f"/path/to/{name}",
            "type": "plugin"
        }

    @staticmethod
    def create_cleaning_result(success=True, message="Success", duration=1.5):
        """Create cleaning result for testing."""
        return CleanResult(
            success=success,
            message=message,
            duration=duration,
            status="cleaned" if success else "failed"
        )

    @staticmethod
    def create_state_update(**kwargs):
        """Create state update data for testing."""
        defaults = {
            "is_cleaning": False,
            "total_plugins": 0,
            "plugins_to_clean": [],
            "progress": 0
        }
        defaults.update(kwargs)
        return defaults

def test_with_factory_data():
    """Test using factory-created data."""
    plugin_data = TestDataFactory.create_plugin_data("test.esp", 2048)
    cleaning_result = TestDataFactory.create_cleaning_result(True, "Cleaned successfully")
    
    assert plugin_data["name"] == "test.esp"
    assert plugin_data["size"] == 2048
    assert cleaning_result.success is True
```

## Test Categories and Patterns

### Unit Tests
```python
# ✅ CORRECT: Test individual components in isolation
class TestStateManager:
    def test_initialization_creates_empty_state(self):
        """Test that state manager initializes with empty state."""
        manager = StateManager()
        assert manager.get_data("nonexistent") is None
        assert manager._data == {}
    
    def test_update_data_stores_value(self):
        """Test that update_data stores values correctly."""
        manager = StateManager()
        manager.update_data("test_key", "test_value")
        assert manager.get_data("test_key") == "test_value"
    
    def test_update_multiple_data_items(self):
        """Test updating multiple data items at once."""
        manager = StateManager()
        manager.update_multiple(key1="value1", key2="value2")
        assert manager.get_data("key1") == "value1"
        assert manager.get_data("key2") == "value2"
```

