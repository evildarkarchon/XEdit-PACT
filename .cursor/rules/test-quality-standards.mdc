### Test Data Factories
```python
# ✅ CORRECT: Use factories for complex test data
class TestDataFactory:
    @staticmethod
    def create_plugin_data(name="test.esp", size=1024, modified_date=None):
        """Create plugin data for testing."""
        if modified_date is None:
            modified_date = datetime.now()
        
        return {
            "name": name,
            "size": size,
            "modified": modified_date,
            "path": f"/path/to/{name}"
        }

    @staticmethod
    def create_cleaning_result(success=True, message="Success", duration=1.5):
        """Create cleaning result for testing."""
        return CleanResult(
            success=success,
            message=message,
            duration=duration,
            status="cleaned" if success else "failed"
        )

def test_with_factory_data():
    """Test using factory-created data."""
    plugin_data = TestDataFactory.create_plugin_data("test.esp", 2048)
    cleaning_result = TestDataFactory.create_cleaning_result(True, "Cleaned successfully")
    
    # Use the factory data in tests
    assert plugin_data["name"] == "test.esp"
    assert cleaning_result.success is True
```

## Assertion Standards

### Meaningful Assertions
```python
# ✅ CORRECT: Specific and meaningful assertions
def test_cleaning_worker_updates_progress():
    """Test that cleaning worker updates progress correctly."""
    worker = CleaningWorker(mock_service, mock_state, ["plugin1.esp"])
    
    worker.run()
    
    # Specific assertions about behavior
    mock_state.update.assert_called_with(
        is_cleaning=True,
        total_plugins=1,
        plugins_to_clean=["plugin1.esp"],
        progress=0
    )
    mock_state.add_result.assert_called_with("plugin1.esp", "cleaned", mock.ANY)

# ❌ WRONG: Vague assertions
def test_cleaning_worker_works():
    """Test that cleaning worker works."""
    worker = CleaningWorker(mock_service, mock_state, ["plugin1.esp"])
    worker.run()
    assert worker is not None  # This doesn't test anything meaningful
```

### Exception Testing
```python
# ✅ CORRECT: Test exceptions properly
def test_cleaning_worker_handles_service_errors():
    """Test that cleaning worker handles service errors gracefully."""
    mock_service = Mock()
    mock_service.validate_environment.return_value = (False, "Service unavailable")
    
    worker = CleaningWorker(mock_service, mock_state, ["plugin1.esp"])
    worker.run()
    
    # Test that error signal was emitted
    worker.error_occurred.emit.assert_called_with("Service unavailable")

def test_yaml_manager_handles_file_errors():
    """Test that YAML manager handles file errors gracefully."""
    manager = YamlManager()
    
    # Test with non-existent file
    result = manager.get_value("/nonexistent/file.yaml", "key")
    assert result is None
    
    # Test with invalid YAML
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yaml") as f:
        f.write("invalid: yaml: content: [")
        f.flush()
        
        result = manager.get_value(f.name, "key")
        assert result is None
```

## Test Isolation

### Independent Tests
```python
# ✅ CORRECT: Tests that don't depend on each other
class TestCleaningWorker:
    def test_worker_initialization(self):
        """Test worker initialization."""
        worker = CleaningWorker(mock_service, mock_state, [])
        assert worker.service == mock_service
        assert worker.state == mock_state
        assert worker.plugins == []
    
    def test_worker_stop_mechanism(self):
        """Test worker stop mechanism."""
        worker = CleaningWorker(mock_service, mock_state, ["plugin1.esp"])
        worker._should_stop = True
        
        worker.run()
        
        # Verify worker stopped early
        mock_service.clean_plugin.assert_not_called()

# ❌ WRONG: Tests that depend on each other
class TestBadDependency:
    def test_first(self):
        """First test that sets up state."""
        global shared_state
        shared_state = "setup"
        assert shared_state == "setup"
    
    def test_second(self):
        """Second test that depends on first test."""
        global shared_state
        assert shared_state == "setup"  # Depends on test_first
```

