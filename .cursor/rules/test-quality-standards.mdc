    """Test complex operation that may take time."""
    result = complex_function(large_dataset)
    assert result is not None
```

### Thread Safety Testing
```python
# ✅ CORRECT: Test thread safety properly
def test_thread_safety_with_stress_testing():
    """Test thread safety with stress testing."""
    import threading
    import time
    
    manager = ThreadSafeManager()
    results = []
    
    def worker_function(thread_id):
        for i in range(100):
            manager.update_data(f"key_{thread_id}_{i}", f"value_{i}")
            time.sleep(0.001)  # Increase race condition chance
    
    # Create multiple threads
    threads = []
    for i in range(5):
        thread = threading.Thread(target=worker_function, args=(i,))
        threads.append(thread)
        thread.start()
    
    # Wait for all threads to complete
    for thread in threads:
        thread.join()
    
    # Verify data consistency
    assert manager.is_consistent()
```

